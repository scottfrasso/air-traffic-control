{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "agentmesh",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-10",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  "artifacts": [{ "binding": "ARTIFACTS", "namespace": "agentmesh" }],
  "durable_objects": {
    "bindings": [{ "name": "COORDINATOR", "class_name": "Coordinator" }]
  },
  "exports": {
    "Coordinator": { "type": "durable-object", "storage": "sqlite" }
  },
  "queues": {
    "consumers": [{ "queue": "agentmesh-push-events", "max_batch_size": 10, "max_batch_timeout": 0, "max_retries": 3 }]
  },
  "workflows": [{ "name": "agentmesh-push-pipeline", "binding": "PUSH_PIPELINE", "class_name": "PushPipeline" }],
  "vars": {
    "ARTIFACTS_NAMESPACE": "agentmesh",
    "CF_ACCOUNT_ID": "cd5005b633a7bdac0f47d9f93c3ad45c",
    "PUSH_QUEUE_ID": "9d2beda0c8d84a39a41c90fa5d59fd9f"
  }
}
