{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "agentmesh",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-10",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  "artifacts": [{ "binding": "ARTIFACTS", "namespace": "agentmesh" }],
  "durable_objects": {
    "bindings": [
      { "name": "CHECKER", "class_name": "Checker" },
      { "name": "REPOS", "class_name": "RepoStore" },
      { "name": "DIRECTORY", "class_name": "Directory" }
    ]
  },
  "exports": {
    "Checker": { "type": "durable-object", "storage": "sqlite" },
    "RepoStore": { "type": "durable-object", "storage": "sqlite" },
    "Directory": { "type": "durable-object", "storage": "sqlite" }
  },
  "containers": [
    {
      "class_name": "Checker",
      "scheduling_policy": "durable_object",
      "images": { "checker": { "dockerfile": "./container/Dockerfile" } }
    }
  ],
  "queues": {
    "consumers": [{ "queue": "agentmesh-push-events", "max_batch_size": 10, "max_batch_timeout": 0, "max_retries": 3, "dead_letter_queue": "agentmesh-push-events-dlq" }]
  },
  "workflows": [
    { "name": "agentmesh-review-run", "binding": "REVIEW_RUN", "class_name": "ReviewRun" }
  ],
  "vars": {
    "ARTIFACTS_NAMESPACE": "agentmesh",
    "CF_ACCOUNT_ID": "cd5005b633a7bdac0f47d9f93c3ad45c",
    "PUSH_QUEUE_ID": "9d2beda0c8d84a39a41c90fa5d59fd9f",
    // Review pipeline. Access: the team domain (e.g. acme.cloudflareaccess.com) and the application's AUD tag.
    "ACCESS_TEAM_DOMAIN": "",
    "ACCESS_AUD": "",
    // From `pnpm setup:agents` (Managed Agents ids). The ANTHROPIC_API_KEY is a secret.
    "AGENT_IDS": "",
    "AGENT_ENVIRONMENT_ID": ""
  }
}
